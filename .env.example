# VaultOS environment template
# Copy to `.env` at the repository root and fill in values.
# Never commit `.env` or `.env.local` files.

# --- Supabase (required) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Aliases used by some scripts
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=

# --- Login app (Vite; synced into artifacts/login-app/.env.local for dev) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_SERVER_URL=

# --- API server (required in production) ---
SESSION_SECRET=

# --- Database (migrations, lib/db, apply-* scripts) ---
DATABASE_URL=

# --- AI providers ---
OPENAI_API_KEY=

# Optional browser dev fallback (stored connection apiKey is preferred)
VITE_OPENAI_API_KEY=

# --- Billing / payments (optional client-side) ---
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_FAWRY_API_URL=

# --- WhatsApp runtime (optional) ---
VITE_WHATSAPP_USE_META=

# --- Cloudflare tunnel (local webhook development) ---
CLOUDFLARE_TUNNEL_NAME=
CLOUDFLARE_TUNNEL_HOSTNAME=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=

# --- Observability / infrastructure (optional) ---
REDIS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Webhook behavior (optional) ---
WEBHOOK_REQUIRE_SIGNATURE=
WEBHOOK_EXECUTE_AI=
WEBHOOK_BASE_URL=

# --- Dev / test toggles (optional) ---
NODE_ENV=
PORT=
EMBEDDING_E2E_LIVE=
VAULTOS_PRODUCTION_GATE=
