# VaultOS runtime environment (copy to .env and fill values)

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Portal — public api-server base URL for WhatsApp webhook display (no trailing slash)
# After `pnpm tunnel:setup`, this is set automatically to https://<CLOUDFLARE_TUNNEL_HOSTNAME>
VITE_API_SERVER_URL=https://webhook.yourdomain.com

# Named Cloudflare Tunnel (stable Meta webhook callback — do NOT use trycloudflare quick tunnels)
# 1) cloudflared tunnel login
# 2) Set name + hostname below, then: pnpm tunnel:setup
CLOUDFLARE_TUNNEL_NAME=vaultos-webhook
CLOUDFLARE_TUNNEL_HOSTNAME=webhook.yourdomain.com
# Written by tunnel:setup:
# CLOUDFLARE_TUNNEL_ID=
# Alternative: token from Cloudflare Zero Trust dashboard (hostname configured in dashboard)
# CLOUDFLARE_TUNNEL_TOKEN=

# OpenAI — required for live embedding worker / production validation
# Used by lib/embedding-platform OpenAI adapter when connection.configuration.apiKey is absent
# OpenAI (server-side scripts, tenant bootstrap, api-server)
OPENAI_API_KEY=sk-your-openai-api-key

# Optional browser dev fallback for login-app (stored connection apiKey is preferred)
# VITE_OPENAI_API_KEY=sk-your-openai-api-key
