# LOCAL-only per-developer integration profile (gitignored).
# Copy to: .env.local.integration
#
# Used by:
#   - pnpm dev:tunnel / pnpm dev:integration
#   - localstack bootstrap overlay (webhook bases survive ensure-localstack-env)
#   - API outbound guard (integration mode)
#
# NEVER put webhook.valueor.org or vaultos-webhook here.
# NEVER point CLOUDFLARE_TUNNEL_CONFIG at infra/cloudflare/config.yml.

VALUEOR_ENV=local

# Opt-in integration profile (required together with outbound flag for real sends)
LOCAL_INTEGRATION_ENABLED=false

# Keep 0 for normal local work. Set to 1 only when intentionally testing real Meta/Twilio sends.
ALLOW_LOCAL_EXTERNAL_OUTBOUND=0

# Your personal public tunnel origin (https, no trailing slash)
PUBLIC_WEBHOOK_BASE_URL=https://webhook-YOURNAME.example.test
WEBHOOK_BASE_URL=https://webhook-YOURNAME.example.test
VITE_WEBHOOK_BASE_URL=https://webhook-YOURNAME.example.test

# Per-developer cloudflared config (NOT infra/cloudflare/config.yml)
CLOUDFLARE_TUNNEL_CONFIG=infra/cloudflare/config.YOURNAME.yml
CLOUDFLARE_TUNNEL_HOSTNAME=webhook-YOURNAME.example.test
CLOUDFLARE_TUNNEL_NAME=valueor-local-YOURNAME
# CLOUDFLARE_TUNNEL_ID=
# CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=
# Prefer config-file mode over CLOUDFLARE_TUNNEL_TOKEN for local isolation.
