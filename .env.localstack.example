# Local Supabase profile template (VALUEOR_ENV=local)
# Copy is unnecessary — generate the real file with:
#   node scripts/ensure-localstack-env.mjs
#
# This file is documentation only. Never commit `.env.localstack`.
# Root `.env` (production/hosting) is left untouched by local mode.

VALUEOR_ENV=local
NODE_ENV=development
# Local API (must not collide with production API on :3000)
PORT=3001

SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Do not set SUPABASE_PROJECT_REF or SUPABASE_DB_PASSWORD in local mode.

VITE_API_SERVER_URL=http://localhost:3001
VITE_APP_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
LOGIN_APP_URL=http://localhost:5173

# Webhook bases intentionally unset — do not default to https://webhook.valueor.org
# Per-developer LOCAL tunnel: copy .env.local.integration.example → .env.local.integration
# and run `pnpm dev:tunnel` (see docs/operations/local-integration-tunnel.md).
# WEBHOOK_BASE_URL=
# VITE_WEBHOOK_BASE_URL=
# PUBLIC_WEBHOOK_BASE_URL=
# LOCAL_INTEGRATION_ENABLED=false
# ALLOW_LOCAL_EXTERNAL_OUTBOUND=0

SESSION_SECRET=dev-secret-change-me
INTERNAL_API_KEY=dev-internal-api-key

# LOCAL-ONLY: Postgres pgp_sym_encrypt secret for WhatsApp / channel / platform AI credentials.
# Written + synced to public.platform_ai_settings (key=crypto_secret) by ensure-localstack-env.mjs.
# Never copy a production crypto secret here.
# PLATFORM_AI_CRYPTO_SECRET=

# WhatsApp Embedded Signup (defaults OFF)
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
VITE_WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
WHATSAPP_COEXISTENCE_ENABLED=false
VITE_WHATSAPP_COEXISTENCE_ENABLED=false
WHATSAPP_EMBEDDED_SIGNUP_AUTO_SUBSCRIBE=false
WHATSAPP_EMBEDDED_SIGNUP_ALLOW_PRODUCTION_SUBSCRIBE=false
# META_EMBEDDED_SIGNUP_APP_ID=
# META_EMBEDDED_SIGNUP_APP_SECRET=
# META_EMBEDDED_SIGNUP_CONFIG_ID=
