# Mobile staging only. The web app keeps Local and Production and does not read this file.
# Copy to .env.staging after a separate Supabase Free project exists.
# The API process stays on this PC. The phone reaches it through a temporary HTTPS tunnel.
# Do not put these values in the mobile bundle except the three EXPO_PUBLIC entries.
# Never put the service-role key in the mobile app.
# Leave provider send switches off. Staging must not deliver real customer messages.

VALUEOR_ENV=staging
NODE_ENV=production
PORT=3011

# Dedicated staging Supabase project. Do not use the Production project.
# Set SUPABASE_REGION to that project's region before the pooler URL is derived.
SUPABASE_URL=
VITE_SUPABASE_URL=
SUPABASE_REGION=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Local listener. The staging process binds 127.0.0.1 only.
VITE_API_SERVER_URL=http://127.0.0.1:3011

# Fill EXPO_PUBLIC_API_URL with the https://*.trycloudflare.com URL printed by the tunnel.
# Leave it empty until that URL exists. Point the Supabase public values at the staging project.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SESSION_SECRET=
INTERNAL_API_KEY=

# Leave webhook and provider secrets empty until staging credentials exist.
# Do not point these at api.valueor.org, app.valueor.org, or webhook.valueor.org.
WEBHOOK_BASE_URL=
VITE_APP_ORIGIN=
FRONTEND_ORIGIN=
EMBEDDING_WORKER_ENABLED=false
BILLING_LIFECYCLE_WORKER_ENABLED=false
SALES_FOLLOW_UP_WORKER_ENABLED=false
SALES_FOLLOW_UP_WORKER_ALLOW_SEND=false
EMAIL_POLL_WORKER_ENABLED=false
WHATSAPP_REPLY_RECOVERY_WORKER_ENABLED=false
