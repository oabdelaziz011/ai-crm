# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Environment and secrets (never commit real values)
.env
.env.*
!.env.example
artifacts/login-app/.env.local

# Local auth/session bootstrap artifacts (generated by scripts)
artifacts/inbox-session.json
artifacts/inbox-browser-session.json
**/*-session.json

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Local performance profiling output
artifacts/performance-profile/

# UX verification screenshots (generated during manual QA)
artifacts/login-app/docs/ux-*/

# Generated architecture traces, probes, and reports
docs/architecture/*-trace.json
docs/architecture/*-probe.json
docs/architecture/*-report.json
docs/architecture/rc2-*.json
docs/architecture/rc3-*.json
docs/architecture/sprint-ai3-*.json
docs/architecture/book-workflow-*.json
docs/architecture/production-booking-flow-e2e-report.json
