# Desktop Metro only. Preview and production builds reject 127.0.0.1, localhost, and ::1.
# Android emulator host: http://10.0.2.2:3001
# Physical device: a LAN address or hosted HTTPS URL. Do not point a phone at this loopback value.
# Use the Supabase publishable key. Never set a service-role key here.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
