# Cloudflare proxied records. TLS uses an origin certificate mounted at
# /etc/caddy/certs/origin.pem and origin.key. Browsers reach Cloudflare, and
# Cloudflare uses Full (strict) to this origin. Do not commit the certificate.

app.valueor.org {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy frontend:8080
}

api.valueor.org, webhook.valueor.org {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy api:3000 {
		flush_interval -1
	}
}
