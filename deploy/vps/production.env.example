# VPS production environment. Copy to deploy/vps/production.env on the server.
# Leave secret values empty here. Never commit production.env.
# Public hostnames below are the deployment targets, not credentials.

VALUEOR_ENV=production
NODE_ENV=production
# Nginx upstream for the Hetzner cutover. systemd also forces PORT=3001.
PORT=3001

# Mailbox for Let's Encrypt notices when using the default Caddyfile (DNS-only).
# Not required when CADDYFILE=./Caddyfile.cloudflare (origin certificates). Not a secret.
ACME_EMAIL=

# Browser, API, and webhook origins. Do not point these at localhost.
# Frontend origin may be https://app.valueor.org or https://www.valueor.org during cutover.
VITE_APP_ORIGIN=https://app.valueor.org
FRONTEND_ORIGIN=https://app.valueor.org
VITE_SITE_URL=https://www.valueor.org
VITE_API_SERVER_URL=https://api.valueor.org
WEBHOOK_BASE_URL=https://webhook.valueor.org
VITE_WEBHOOK_BASE_URL=https://webhook.valueor.org
PUBLIC_WEBHOOK_BASE_URL=https://webhook.valueor.org
# Nginx/systemd cutover listens on 3001 behind the Origin Certificate proxy.
# PORT=3001

# Hosted Supabase project. Values stay on the server.
SUPABASE_URL=
VITE_SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_REGION=eu-north-1
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Session and internal API. Generate new values on the server. Do not reuse development placeholders.
SESSION_SECRET=
INTERNAL_API_KEY=

# Embedding worker. ALERT_WEBHOOK_URL is optional (structured logs always; no webhook sink wired yet).
EMBEDDING_WORKER_ENABLED=true
ALERT_WEBHOOK_URL=
WORKER_POLL_MS=5000
WORKER_BATCH_SIZE=8

# In-process API timers. Billing stays off until the API is ready and this pair is set.
BILLING_LIFECYCLE_WORKER_ENABLED=false
BILLING_LIFECYCLE_WORKER_CONFIRMED=false
SALES_FOLLOW_UP_WORKER_ENABLED=false
SALES_FOLLOW_UP_WORKER_ALLOW_SEND=false
EMAIL_POLL_WORKER_ENABLED=true
SESSION_IDLE_TIMEOUT_WORKER_ENABLED=true
WHATSAPP_REPLY_RECOVERY_WORKER_ENABLED=false

# Checkout. Set one provider only after its secrets exist on this host.
SAAS_CHECKOUT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# WhatsApp Embedded Signup (server runtime). Frontend VITE_* gates are baked in
# .github/workflows/vps-deploy.yml — do not rely on VITE_* here for the browser UI.
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=
WHATSAPP_COEXISTENCE_ENABLED=
WHATSAPP_EMBEDDED_SIGNUP_AUTO_SUBSCRIBE=
WHATSAPP_EMBEDDED_SIGNUP_ALLOW_PRODUCTION_SUBSCRIBE=
WHATSAPP_EMBEDDED_SIGNUP_ALLOWED_COMPANY_IDS=
WHATSAPP_EMBEDDED_SIGNUP_REGISTER_PHONE=
META_EMBEDDED_SIGNUP_APP_ID=
META_EMBEDDED_SIGNUP_APP_SECRET=
META_EMBEDDED_SIGNUP_CLOUD_API_CONFIG_ID=
META_EMBEDDED_SIGNUP_COEXISTENCE_CONFIG_ID=
# Deprecated dual-path leftover — leave empty; path-specific CONFIG_ID vars above are authoritative.
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_EMBEDDED_SIGNUP_STATE_SECRET=
META_EMBEDDED_SIGNUP_GRAPH_VERSION=v21.0
# Documented only: browser bake uses workflow env, not this file.
VITE_WHATSAPP_EMBEDDED_SIGNUP_ENABLED=
VITE_WHATSAPP_COEXISTENCE_ENABLED=

# Meta Messenger Facebook Login for Business (keep disabled until App Review + allowlist).
META_MESSENGER_OAUTH_ENABLED=
META_MESSENGER_OAUTH_ALLOWED_COMPANY_IDS=
META_MESSENGER_OAUTH_APP_ID=
META_MESSENGER_OAUTH_APP_SECRET=
META_MESSENGER_OAUTH_REDIRECT_URI=
META_MESSENGER_OAUTH_GRAPH_VERSION=v21.0
META_MESSENGER_OAUTH_STATE_SECRET=
VITE_META_MESSENGER_OAUTH_ENABLED=

# Meta Instagram Login (keep disabled until Instagram permissions + allowlist).
META_INSTAGRAM_LOGIN_ENABLED=
META_INSTAGRAM_LOGIN_ALLOWED_COMPANY_IDS=
META_INSTAGRAM_LOGIN_APP_ID=
META_INSTAGRAM_LOGIN_APP_SECRET=
META_INSTAGRAM_LOGIN_REDIRECT_URI=
META_INSTAGRAM_LOGIN_GRAPH_VERSION=v21.0
META_INSTAGRAM_LOGIN_STATE_SECRET=
VITE_META_INSTAGRAM_LOGIN_ENABLED=

# Legacy Meta Pages OAuth (shared fallback allowlist / credentials). Prefer dedicated gates above.
META_PAGES_OAUTH_ENABLED=
META_PAGES_OAUTH_ALLOWED_COMPANY_IDS=
META_PAGES_OAUTH_APP_ID=
META_PAGES_OAUTH_APP_SECRET=
META_PAGES_OAUTH_GRAPH_VERSION=v21.0
META_PAGES_OAUTH_STATE_SECRET=
VITE_META_PAGES_OAUTH_ENABLED=

# Shared Meta OAuth redirect base (API) and post-login frontend return.
META_OAUTH_PUBLIC_API_BASE_URL=https://api.valueor.org
LOGIN_APP_URL=https://www.valueor.org

# Optional AI and mail providers. Empty means that provider stays unused.
OPENAI_API_KEY=
RESEND_API_KEY=
