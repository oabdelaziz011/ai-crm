# VPS production environment. Copy to deploy/vps/production.env on the server.
# Leave secret values empty here. Never commit production.env.
# Public hostnames below are the deployment targets, not credentials.

VALUEOR_ENV=production
NODE_ENV=production
# Nginx upstream for the Hetzner cutover. systemd also forces PORT=3001.
PORT=3001

# Mailbox that receives certificate notices. Not a secret.
ACME_EMAIL=

# Browser, API, and webhook origins. Do not point these at localhost.
# Frontend origin may be https://app.valueor.org or https://www.valueor.org during cutover.
VITE_APP_ORIGIN=https://app.valueor.org
FRONTEND_ORIGIN=https://app.valueor.org
VITE_SITE_URL=https://app.valueor.org
VITE_API_SERVER_URL=https://api.valueor.org
WEBHOOK_BASE_URL=https://webhook.valueor.org
VITE_WEBHOOK_BASE_URL=https://webhook.valueor.org
PUBLIC_WEBHOOK_BASE_URL=https://webhook.valueor.org
# Nginx/systemd cutover listens on 3001 behind the Origin Certificate proxy.
# PORT=3001

# Hosted Supabase project. Values stay on the server.
SUPABASE_URL=
VITE_SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_REGION=eu-north-1
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Session and internal API. Generate new values on the server. Do not reuse development placeholders.
SESSION_SECRET=
INTERNAL_API_KEY=

# Embedding worker. ALERT_WEBHOOK_URL is required before that container will stay up.
EMBEDDING_WORKER_ENABLED=true
ALERT_WEBHOOK_URL=
WORKER_POLL_MS=5000
WORKER_BATCH_SIZE=8

# In-process API timers. Billing stays off until the API is ready and this pair is set.
BILLING_LIFECYCLE_WORKER_ENABLED=false
BILLING_LIFECYCLE_WORKER_CONFIRMED=false
SALES_FOLLOW_UP_WORKER_ENABLED=false
SALES_FOLLOW_UP_WORKER_ALLOW_SEND=false
EMAIL_POLL_WORKER_ENABLED=true
SESSION_IDLE_TIMEOUT_WORKER_ENABLED=true
WHATSAPP_REPLY_RECOVERY_WORKER_ENABLED=false

# Checkout. Set one provider only after its secrets exist on this host.
SAAS_CHECKOUT_PROVIDER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# WhatsApp embedded signup stays unset until Meta credentials are intended.
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=
WHATSAPP_EMBEDDED_SIGNUP_ALLOW_PRODUCTION_SUBSCRIBE=
VITE_WHATSAPP_EMBEDDED_SIGNUP_ENABLED=
META_EMBEDDED_SIGNUP_APP_ID=
META_EMBEDDED_SIGNUP_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Optional AI and mail providers. Empty means that provider stays unused.
OPENAI_API_KEY=
RESEND_API_KEY=
